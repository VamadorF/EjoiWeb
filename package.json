{
  "name": "ejoi-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:demo": "tsc --noEmit && vite build --mode demo --outDir dist-demo",
    "preview": "vite preview",
    "shots": "node scripts/shots.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "sync:app": "node scripts/sync-app.mjs",
    "sync:check": "node scripts/sync-app.mjs --check",
    "test:e2e": "playwright test",
    "e2e": "playwright test",
    "verify": "npm run sync:check && npm run typecheck && npm run lint && npm test && npm run build",
    "ponytail:install": "node ../ejoiFE/ejoi/ponytail/scripts/cursor-hooks.js install --project",
    "ponytail:skills": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/link-ponytail-skills.ps1"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.91.0",
    "i18next": "^26.0.0",
    "ionicons": "^8.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^17.0.0",
    "react-router": "^7.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.30.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.2.0",
    "jsdom": "^26.1.0",
    "sharp": "^0.34.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.35.0",
    "vite": "^7.0.0",
    "vitest": "^4.1.0"
  }
}
